# Read-only log inputs
CADDY_LOG_DIR=/opt/server/management/data/caddy/logs/www2
OBS_CADDY_LOG=/logs/access.jsonl
OBS_ALLOWED_HOSTS=www2.onnwee.me
# Enable only after verifying Caddy trusts the tunnel peer, not arbitrary headers.
OBS_TRUST_CADDY_CLIENT_IP=false
# Optional application event log (single file). Leave blank if unavailable.
OBS_RELAY_LOG=
# Optional directory of relay ledgers (guestbook/wall/notes/files/events .jsonl),
# mounted read-only at /relay by docker-compose.yml.
OBS_RELAY_DIR=/relay

# Persistent private state
OBS_DB=/data/observatory.sqlite3
OBS_KEY_FILE=/data/pseudonym.key

# Dashboard. Keep this localhost-only unless you put real auth in front of it.
OBS_BIND=0.0.0.0
OBS_PORT=9099

# Optional bearer token for /api/* and the dashboard.
# OBS_TOKEN=replace-me

# Session gap in minutes
OBS_SESSION_MINUTES=30

# Max public write content retained from an optional relay event log.
OBS_CONTENT_MAX=8192
